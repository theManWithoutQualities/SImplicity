# Port the web interface listens on
#PORT=3000

# Jitsi deployment to connect to (no protocol, just the host)
JITSI_DOMAIN=meet.jit.si

# Room name prefilled in the web interface (you can always type another one)
#JITSI_ROOM=my-room

# MUC domain, only needed for custom deployments (default: conference.<domain>)
#JITSI_MUC=conference.meet.jit.si

# Guest domain for anonymous access. Default: guest.meet.jit.si when
# JITSI_DOMAIN=meet.jit.si; unset otherwise.
#JITSI_ANONYMOUS_DOMAIN=guest.meet.jit.si

# JWT for deployments with authentication enabled
#JITSI_TOKEN=

# Bot display name in the conference
BOT_NAME=TTS Bot

# Edge TTS voice, e.g. en-US-JennyNeural, en-GB-SoniaNeural, de-DE-ConradNeural
TTS_VOICE=en-US-JennyNeural

# Voice used automatically for text with Cyrillic characters
#TTS_VOICE_RU=ru-RU-SvetlanaNeural

# Set to 1 to show the browser window (debugging)
#HEADFUL=1
